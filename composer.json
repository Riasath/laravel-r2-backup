{
    "name": "riasath/laravel-r2-backup",
    "description": "One-click database backup to Cloudflare R2 for Laravel. Streams a compressed dump straight to object storage — no local disk bloat, no queue required.",
    "keywords": ["laravel", "backup", "database", "cloudflare", "r2", "s3", "mysql", "sqlite"],
    "homepage": "https://www.codefixit.com/riasath",
    "license": "MIT",
    "authors": [
        {
            "name": "Riasath",
            "homepage": "https://www.codefixit.com/riasath"
        }
    ],
    "support": {
        "docs": "https://www.codefixit.com/riasath"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Riasath\\R2Backup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Riasath\\R2Backup\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Riasath\\R2Backup\\R2BackupServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
